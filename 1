            statusLabel.Text = "🔴 OFF"
            statusLabel.TextColor3 = Color3.fromRGB(150, 30, 30)
        end
    end)

    selectAllBtn.MouseButton1Click:Connect(function()
        for fish in pairs(targetFishList) do targetFishList[fish] = true end
        refreshList()
    end)

    deselectAllBtn.MouseButton1Click:Connect(function()
        for fish in pairs(targetFishList) do targetFishList[fish] = false end
        refreshList()
    end)

    refreshList()

    return frame
end

