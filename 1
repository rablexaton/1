            fishBtn.TextXAlignment = Enum.TextXAlignment.Left
            Instance.new("UICorner", fishBtn).CornerRadius = UDim.new(0, 6)

            updateButtonDisplay(fishBtn, fishName)

            fishBtn.MouseButton1Click:Connect(function()
                targetFishList[fishName] = not targetFishList[fishName]
                updateButtonDisplay(fishBtn, fishName)
            end)
        end
    end

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 15)
    end)

    toggleBtn.MouseButton1Click:Connect(function()
        autoDropEnabled = not autoDropEnabled
