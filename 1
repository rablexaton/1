local function processMinigame()
    if isHandlingMinigame then return end
    isHandlingMinigame = true
    
    pcall(function()
        task.wait(MINIGAME_SKIP_DELAY)
        if isMinigameActive() then
            winMinigame()
        end
        task.wait(0.8)
    end)
    
    isHandlingMinigame = false
end

local function startAutoWin()
    if not autoWinEnabled then
        autoWinEnabled = true
        notifyUser("🏆 Auto Win Enabled", "success")
        autoWinThread = task.spawn(function()
            while autoWinEnabled do
                if isMinigameActive() and not isHandlingMinigame then
                    processMinigame()
                end
                task.wait(0.3)
            end
        end)
    end
end

local function stopAutoWin()
    if autoWinEnabled then
        autoWinEnabled = false
        if autoWinThread then
            task.cancel(autoWinThread)
            autoWinThread = nil
        end
        notifyUser("⏹️ Auto Win Disabled", "error")
    end
end

local function toggleAutoWin()
    if autoWinEnabled then
        stopAutoWin()
    else
        startAutoWin()
    end
end

local function startAutoFarm()
    if not autoFarmRunning then
        autoFarmRunning = true
        notifyUser("⚡ Auto Farm Activated ⚡", "success")

        autoFarmThread = task.spawn(function()
            while autoFarmRunning do
                if isMinigameActive() then
                    if autoWinEnabled then
                        processMinigame()
                    end
                    task.wait(1.0)
                elseif not isHandlingMinigame then
                    performClick()
                    task.wait(2.8)
                else
                    task.wait(0.5)
                end
            end
        end)
    end
end

local function stopAutoFarm()
    if autoFarmRunning then
        autoFarmRunning = false
        if autoFarmThread then
            task.cancel(autoFarmThread)
            autoFarmThread = nil
        end
        notifyUser("⏹️ Auto Farm Stopped", "error")
    end
end

local function toggleAutoFarm()
    if autoFarmRunning then
        stopAutoFarm()
    else
        startAutoFarm()
    end
end

