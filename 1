-- Key Verification Routine
local function checkKey()
    if KeyInput.Text == validKey then
        StatusMessage.Text = "WELCOME TO FAST HUB SCRIPT"
        StatusMessage.TextColor3 = Color3.fromRGB(0, 255, 0)
        
        ScreenGui:Destroy()
        
        loadstring(game:HttpGet("https://raw.githubusercontent.com/rablexaton/zzzzzzzzzzz/refs/heads/main/yyyyyyyyyyyyyyyyyyyy"))()
    else
        StatusMessage.Text = "Invalid Key. Try again."
        StatusMessage.TextColor3 = Color3.fromRGB(255, 0, 0)
    end
end

