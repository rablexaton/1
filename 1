local function getNearbyPlayers(maxDistance)
    local nearbyList = {}
    local myChar = LocalPlayer.Character
    if not myChar then return "Aucun" end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return "Aucun" end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - myHrp.Position).Magnitude
                if dist <= maxDistance then
                    table.insert(nearbyList, player.Name .. " (" .. math.floor(dist) .. "m)")
                end
            end
        end
    end

    return #nearbyList == 0 and ("Aucun joueur à moins de " .. tostring(maxDistance) .. "m") or table.concat(nearbyList, ", ")
end

