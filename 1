        if targetFishList[fishName] then
            button.BackgroundColor3 = Color3.fromRGB(150, 20, 20)
            button.Text = "   ✅ " .. fishName
        else
            button.BackgroundColor3 = Color3.fromRGB(25, 5, 5)
            button.Text = "   ⬜ " .. fishName
        end
    end

    local function refreshList()
        for _, child in scroll:GetChildren() do
            if child:IsA("TextButton") then child:Destroy() end
        end

        local sortedNames = {}
        for fishName in pairs(targetFishList) do
            table.insert(sortedNames, fishName)
        end
        table.sort(sortedNames)

        for _, fishName in ipairs(sortedNames) do
            local fishBtn = Instance.new("TextButton", scroll)
            fishBtn.Size = UDim2.new(1, -8, 0, 30)
            fishBtn.Font = Enum.Font.Gotham
            fishBtn.TextSize = 13
